# Copy file này thành .env và điền giá trị thực
# cp .env.example .env   (Linux/Mac)  hoặc  copy .env.example .env  (Windows)

# Flask
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# MySQL - BẮT BUỘC để load dữ liệu từ SQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=plate_violation

# Sau khi tạo database, chạy schema: mysql -u root -p plate_violation < database/schema.sql
# Hoặc dùng: python run_migration.py

# Telegram (tùy chọn)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
